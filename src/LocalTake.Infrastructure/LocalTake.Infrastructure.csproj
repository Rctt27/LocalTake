<Project Sdk="Microsoft.NET.Sdk">

  <!-- Portable adapters: settings file, ffmpeg processes, transcription, local log file. Runs on Windows and macOS alike. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LocalTake.Infrastructure</RootNamespace>
    <!-- The macOS app is trimmed: reflection on .NET's types is reported here, on every OS. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- WhisperRuntimes only concerns this project: Core stays one build, shared with the projects that do not set it. -->
    <ProjectReference Include="..\LocalTake.Core\LocalTake.Core.csproj" GlobalPropertiesToRemove="WhisperRuntimes" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" />
    <!-- whisper.cpp, run on this computer; its runtime brings the native libraries of every platform. -->
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="Whisper.net.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LocalTake.Infrastructure.IntegrationTests" />
  </ItemGroup>

  <!--
    Whisper.net.Runtime brings the native libraries of every platform, which the macOS SDK would try to process as its
    own (the Linux ones fail): the macOS app builds this project with WhisperRuntimes=macos, which keeps only the macOS
    ones. The items come from the package's targets, imported after this file, hence a target rather than an ItemGroup.
  -->
  <Target Name="DropWhisperRuntimes" BeforeTargets="AssignTargetPaths" Condition="'$(WhisperRuntimes)' == 'macos'">
    <ItemGroup>
      <None Remove="@(None)" Condition="$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/')) And !$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/macos-'))" />
    </ItemGroup>
  </Target>

</Project>
