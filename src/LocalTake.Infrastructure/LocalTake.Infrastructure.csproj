<Project Sdk="Microsoft.NET.Sdk">

  <!-- Portable adapters: settings file, ffmpeg processes, local log file. Runs on Windows and macOS alike. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LocalTake.Infrastructure</RootNamespace>
    <!-- The macOS app is trimmed: reflection on .NET's types is reported here, on every OS. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalTake.Core\LocalTake.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LocalTake.Infrastructure.IntegrationTests" />
  </ItemGroup>

</Project>
