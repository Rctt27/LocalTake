<Project Sdk="Microsoft.NET.Sdk">

  <!-- Portable adapters: settings file, ffmpeg processes, transcription, local log file. Runs on Windows and macOS alike. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LocalTake.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalTake.Core\LocalTake.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" />
    <!-- whisper.cpp, run on this computer; its runtime brings the native libraries of every platform. -->
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="Whisper.net.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LocalTake.Infrastructure.IntegrationTests" />
  </ItemGroup>

</Project>
