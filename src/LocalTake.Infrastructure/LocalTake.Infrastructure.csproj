<Project Sdk="Microsoft.NET.Sdk">

  <!-- Portable adapters: settings file, ffmpeg processes, transcription, local log file. Runs on Windows and macOS alike. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LocalTake.Infrastructure</RootNamespace>
    <!-- The macOS app is trimmed: reflection on .NET's types is reported here, on every OS. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- WhisperRuntimes only concerns this project: Core stays one build, shared with the projects that do not set it. -->
    <ProjectReference Include="..\LocalTake.Core\LocalTake.Core.csproj" GlobalPropertiesToRemove="WhisperRuntimes" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" />
    <!-- whisper.cpp, run on this computer; its runtime brings the native libraries of every platform. -->
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="Whisper.net.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LocalTake.Infrastructure.IntegrationTests" />
  </ItemGroup>

  <!--
    An app that does not transcribe (the macOS app, for now) builds this project with WhisperRuntimes=false: it then
    gets none of Whisper's native libraries, which the macOS SDK would try to process as its own (the Linux ones fail).
    The items come from the package's targets, imported after this file, hence a target rather than an ItemGroup.
  -->
  <Target Name="DropWhisperRuntimes" BeforeTargets="AssignTargetPaths" Condition="'$(WhisperRuntimes)' == 'false'">
    <ItemGroup>
      <None Remove="@(None)" Condition="$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/'))" />
    </ItemGroup>
  </Target>

</Project>
