<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What the macOS app needs beyond Apple's bindings: Carbon shortcuts, key codes and the screens' geometry.
    It targets net10.0, so that its geometry is tested on every CI runner.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>LocalTake.Platform.MacOS</RootNamespace>
    <!-- The macOS app is trimmed: reflection on .NET's types is reported here, on every OS. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalTake.Core\LocalTake.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>macos</_Parameter1>
    </AssemblyAttribute>
    <InternalsVisibleTo Include="LocalTake.Platform.Tests" />
  </ItemGroup>

</Project>
