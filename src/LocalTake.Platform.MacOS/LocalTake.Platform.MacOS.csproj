<Project Sdk="Microsoft.NET.Sdk">

  <!--
    macOS implementations of the core's ports, through the Objective-C runtime, Carbon, CoreGraphics and ImageIO.
    Like LocalTake.Platform.Windows, it targets net10.0 so that the app builds anywhere and picks it at run time.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>LocalTake.Platform.MacOS</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalTake.Core\LocalTake.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>macos</_Parameter1>
    </AssemblyAttribute>
    <InternalsVisibleTo Include="LocalTake.Platform.Tests" />
  </ItemGroup>

</Project>
