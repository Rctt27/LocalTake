<Window x:Class="LocalTake.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalTake — Réglages" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5" FontSize="13">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="HotkeyBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Cliquez puis appuyez sur la combinaison voulue. Retour arrière : aucun raccourci."/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
        <GroupBox Header="Enregistrement">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource Label}" Text="Dossier"/>
                <TextBox x:Name="FolderBox" Grid.Column="1" Padding="4,3"/>
                <Button Grid.Column="2" Content="Parcourir…" Padding="10,3" Margin="6,0,0,0" Click="Browse_Click"/>

                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Nom des fichiers" Margin="0,10,10,0"/>
                <TextBox x:Name="PatternBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Padding="4,3" Margin="0,10,0,0"
                         TextChanged="Pattern_TextChanged"/>
                <TextBlock x:Name="PatternPreview" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,4,0,0"/>

                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Format" Margin="0,10,10,0"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <ComboBox x:Name="FormatBox" Width="90" SelectionChanged="Format_SelectionChanged">
                        <ComboBoxItem Content="PNG" Tag="png"/>
                        <ComboBoxItem Content="JPEG" Tag="jpg"/>
                    </ComboBox>
                    <TextBlock x:Name="QualityLabel" Text="Qualité JPEG" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <Slider x:Name="QualitySlider" Width="150" Minimum="10" Maximum="100" TickFrequency="5"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Value, ElementName=QualitySlider}" Width="30" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <CheckBox x:Name="CopyPathBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                          Content="Copier le chemin du fichier dans le presse-papier après l'enregistrement"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Après une capture">
            <ComboBox x:Name="AfterCaptureBox">
                <ComboBoxItem Content="Ouvrir l'éditeur d'annotations" Tag="OpenEditor"/>
                <ComboBoxItem Content="Enregistrer directement dans le dossier" Tag="SaveToFile"/>
                <ComboBoxItem Content="Copier dans le presse-papier" Tag="CopyToClipboard"/>
                <ComboBoxItem Content="Enregistrer et copier dans le presse-papier" Tag="SaveAndCopy"/>
            </ComboBox>
        </GroupBox>

        <GroupBox Header="Vidéo">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource Label}" Text="ffmpeg"/>
                <TextBox x:Name="FfmpegBox" Grid.Column="1" Padding="4,3"
                         ToolTip="Laisser vide pour le chercher à côté de LocalTake puis dans le PATH."/>
                <Button Grid.Column="2" Content="Parcourir…" Padding="10,3" Margin="6,0,0,0" Click="BrowseFfmpeg_Click"/>
                <TextBlock x:Name="FfmpegStatus" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,4,0,0"/>

                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Micro" Margin="0,10,10,0"/>
                <ComboBox x:Name="MicrophoneBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0"/>

                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="RecordMicrophoneBox" Content="Enregistrer le micro" Margin="0,0,20,0"/>
                        <CheckBox x:Name="SystemAudioBox" Content="Enregistrer le son de l'ordinateur"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Les deux se changent aussi sur la barre d'enregistrement, avant de démarrer : le dernier choix est retenu."/>
                </StackPanel>

                <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Images/seconde" Margin="0,10,10,0"/>
                <ComboBox x:Name="FrameRateBox" Grid.Row="4" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Sous-titres">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.ColumnSpan="3">
                    <CheckBox x:Name="TranscribeBox" Content="Transcrire le micro en sous-titres après l'enregistrement"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="La transcription se fait sur cet ordinateur, sans rien envoyer. Les sous-titres s'affichent à côté de la vidéo pour être corrigés, et sont enregistrés dans un fichier .srt du même nom. Le choix se change aussi sur la barre d'enregistrement."/>
                </StackPanel>

                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Langue" Margin="0,10,10,0"/>
                <ComboBox x:Name="LanguageBox" Grid.Row="1" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,10,0,0"
                          DisplayMemberPath="Name" SelectedValuePath="Code"/>

                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Modèle" Margin="0,10,10,0"/>
                <TextBox x:Name="ModelBox" Grid.Row="2" Grid.Column="1" Padding="4,3" Margin="0,10,0,0"
                         ToolTip="Un modèle Whisper (fichier .bin). Laisser vide pour celui livré avec LocalTake."/>
                <Button Grid.Row="2" Grid.Column="2" Content="Parcourir…" Padding="10,3" Margin="6,10,0,0" Click="BrowseModel_Click"/>
                <TextBlock x:Name="ModelStatus" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Raccourcis clavier">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Capturer une zone"/>
                    <TextBox x:Name="HotkeyRegionBox" Grid.Column="1" Style="{StaticResource HotkeyBox}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Capturer une fenêtre"/>
                    <TextBox x:Name="HotkeyWindowBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource HotkeyBox}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Capturer tout l'écran"/>
                    <TextBox x:Name="HotkeyFullScreenBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource HotkeyBox}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Capturer la dernière zone"/>
                    <TextBox x:Name="HotkeyLastRegionBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource HotkeyBox}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Vidéo d'une zone"/>
                    <TextBox x:Name="HotkeyVideoRegionBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource HotkeyBox}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Vidéo de tout l'écran"/>
                    <TextBox x:Name="HotkeyVideoFullScreenBox" Grid.Row="5" Grid.Column="1" Style="{StaticResource HotkeyBox}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Démarrer l'enregistrement"/>
                    <TextBox x:Name="HotkeyVideoStartBox" Grid.Row="6" Grid.Column="1" Style="{StaticResource HotkeyBox}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="Arrêter l'enregistrement"/>
                    <TextBox x:Name="HotkeyVideoStopBox" Grid.Row="7" Grid.Column="1" Style="{StaticResource HotkeyBox}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="Surligner (maintenir)"/>
                    <TextBox x:Name="HighlightTriggerBox" Grid.Row="8" Grid.Column="1" Style="{StaticResource HotkeyBox}"
                             ToolTip="Cliquez puis appuyez sur la touche ou la combinaison à maintenir, ou cliquez avec un bouton latéral de la souris. Retour arrière : aucun surlignage."/>
                    <TextBlock x:Name="HighlightWarning" Grid.Row="9" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,4,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               Text="Pendant l'enregistrement, cette touche n'écrira plus rien dans les applications."/>
                </Grid>
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="Raccourcis de TinyTake" Padding="10,3" Click="DefaultHotkeys_Click"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,10,0"
                               Text="Cliquez dans un champ puis appuyez sur la combinaison. Retour arrière : aucun raccourci. Démarrer, Arrêter et Surligner ne sont actifs que pendant une vidéo."/>
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <CheckBox x:Name="StartupBox" Content="Lancer LocalTake au démarrage de Windows" Margin="2,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" Width="100" Padding="0,5" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Enregistrer" Width="100" Padding="0,5" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
