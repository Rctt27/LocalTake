<Window x:Class="LocalTake.VideoPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalTake"
        Title="LocalTake" Background="#1E1E1E" Width="960" Height="600" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="SeekTrack" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <!-- Taller than the visible line so that the bar is easy to hit. -->
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeekSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Height="18">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SeekTrack}" Background="#0A64AD" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SeekTrack}" Background="#555" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="12" Height="12" Fill="#EEEEEE"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2B2B2B" Padding="10,4" BorderBrush="#111" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- Only while the video has no subtitles: recorded without them, or nothing was heard. -->
                    <Button x:Name="GenerateButton" Style="{StaticResource ActionButton}" Focusable="False" Click="Generate_Click"
                            ToolTipService.ShowOnDisabled="True" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F0;" Margin="0,0,6,0"/>
                            <TextBlock Text="Générer les sous-titres"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Focusable="False" Click="Reveal_Click"
                            ToolTip="Ouvrir le dossier avec la vidéo sélectionnée">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" Margin="0,0,6,0"/>
                            <TextBlock Text="Afficher dans l'Explorateur"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RetakeButton" Style="{StaticResource ActionButton}" Focusable="False" Click="Retake_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" Margin="0,0,6,0"/>
                            <TextBlock Text="Refaire"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Focusable="False" Click="Delete_Click"
                            ToolTip="Envoyer la vidéo à la Corbeille">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" Margin="0,0,6,0"/>
                            <TextBlock Text="Supprimer"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="FileNameText" Foreground="#CCC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#222222" Padding="10,6,10,8">
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="ElapsedText" DockPanel.Dock="Left" Foreground="#999" Text="00:00:00"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TotalText" DockPanel.Dock="Right" Foreground="#999" Text="00:00:00"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Slider x:Name="SeekBar" Style="{StaticResource SeekSlider}" VerticalAlignment="Center"
                            ValueChanged="SeekBar_ValueChanged" MouseMove="SeekBar_MouseMove" MouseLeave="SeekBar_MouseLeave"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Button Style="{StaticResource PlayerButton}" Click="Rewind_Click" ToolTip="Reculer de 10 secondes (←)">&#xEB9E;</Button>
                    <Button Style="{StaticResource PlayerButton}" Click="PlayPause_Click" ToolTip="Lecture / pause (Espace)">
                        <TextBlock x:Name="PlayPauseGlyph" Text="&#xE769;"/>
                    </Button>
                    <Button Style="{StaticResource PlayerButton}" Click="Forward_Click" ToolTip="Avancer de 10 secondes (→)">&#xEB9D;</Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid>
            <!-- The subtitles at the left of the video, shown when there is a transcription or a .srt. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TranscriptColumn" Width="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <local:TranscriptPanel x:Name="Transcript" Visibility="Collapsed"/>
            <GridSplitter x:Name="TranscriptSplitter" Grid.Column="1" Width="5" Background="#111" HorizontalAlignment="Stretch"
                          Focusable="False" Visibility="Collapsed" ToolTip="Glisser pour élargir les sous-titres"/>

            <Grid x:Name="VideoHost" Grid.Column="2" Background="Black" MouseLeftButtonUp="Video_MouseLeftButtonUp">
                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"
                              Stretch="Uniform" MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"
                              MediaFailed="Player_MediaFailed"/>
    
                <!--
                    The subtitle being played, as a player shows it: on a band of translucent black, so that it stays
                    readable on any picture. Placed and sized on the picture itself (PlaceSubtitle), not the letterbox.
                -->
                <Border x:Name="SubtitleBand" Background="#99000000" CornerRadius="3" Padding="10,3"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False" Visibility="Collapsed">
                    <TextBlock x:Name="SubtitleText" Foreground="White" TextAlignment="Center" TextWrapping="Wrap"/>
                </Border>

                <!-- Shows briefly what a click on the video just did. -->
                <Border x:Name="FlashBadge" Width="72" Height="72" CornerRadius="36" Background="#99000000"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="FlashGlyph" Style="{StaticResource Glyph}" FontSize="30" Foreground="White"
                               HorizontalAlignment="Center"/>
                </Border>
    
                <Border x:Name="ReplayButton" Width="100" Height="100" CornerRadius="50" Background="#B0000000"
                        BorderBrush="#EEEEEE" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Cursor="Hand" Visibility="Collapsed" ToolTip="Revoir la vidéo" MouseLeftButtonUp="Replay_MouseLeftButtonUp">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="40" Foreground="White"
                               HorizontalAlignment="Center" Margin="6,0,0,0"/>
                </Border>
    
                <Border x:Name="ErrorPanel" Background="#2B2B2B" Padding="20" CornerRadius="6" MaxWidth="520"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ErrorText" Foreground="#EEE" TextWrapping="Wrap"/>
                        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Click="OpenExternally_Click">Ouvrir avec le lecteur par défaut</Button>
                    </StackPanel>
                </Border>
    
                <Popup x:Name="ThumbnailPopup" PlacementTarget="{Binding ElementName=SeekBar}" Placement="Top"
                       VerticalOffset="-6" AllowsTransparency="True" IsHitTestVisible="False">
                    <Border Background="#222222" BorderBrush="#555" BorderThickness="1" CornerRadius="3" Padding="2">
                        <StackPanel>
                            <MediaElement x:Name="ThumbnailPlayer" Width="160" Height="90" LoadedBehavior="Manual"
                                          UnloadedBehavior="Manual" ScrubbingEnabled="True" IsMuted="True" Stretch="Uniform"
                                          MediaOpened="ThumbnailPlayer_MediaOpened" MediaFailed="ThumbnailPlayer_MediaFailed"/>
                            <TextBlock x:Name="ThumbnailTime" Foreground="#EEE" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
