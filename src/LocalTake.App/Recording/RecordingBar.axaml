<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LocalTake.App.Recording.RecordingBar"
        Title="LocalTake — enregistrement"
        SystemDecorations="None" Topmost="True" ShowInTaskbar="False" CanResize="False"
        SizeToContent="WidthAndHeight" Background="Transparent" TransparencyLevelHint="Transparent">
    <Border Background="#F0202020" CornerRadius="8" BorderBrush="#444" BorderThickness="1" Padding="10,6">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <StackPanel x:Name="DragArea" Orientation="Horizontal" Spacing="8" Background="Transparent" VerticalAlignment="Center"
                        ToolTip.Tip="Glisser pour déplacer · invisible dans la vidéo">
                <Ellipse x:Name="Dot" Width="12" Height="12" Fill="#E53935" Opacity="0.35" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="Prêt à enregistrer" VerticalAlignment="Center" MinWidth="150" />
            </StackPanel>

            <ToggleButton x:Name="MicrophoneToggle" Padding="8,3">
                <TextBlock x:Name="MicrophoneLabel" Text="🎤 Micro" />
            </ToggleButton>
            <ComboBox x:Name="MicrophoneBox" MaxWidth="220" IsVisible="False" ToolTip.Tip="Micro utilisé" VerticalAlignment="Center" />
            <ToggleButton x:Name="SystemAudioToggle" Padding="8,3">
                <TextBlock x:Name="SystemAudioLabel" Text="🔊 Son de l'ordinateur" />
            </ToggleButton>

            <Button x:Name="StartButton" Classes="primary" Content="●  Démarrer"
                    ToolTip.Tip="Lancer le compte à rebours de 3 secondes, puis l'enregistrement" />
            <Button x:Name="StopButton" Classes="primary" Content="■  Arrêter" IsVisible="False"
                    ToolTip.Tip="Arrêter et enregistrer la vidéo" />
            <Button x:Name="CancelButton" Classes="action" Content="✕"
                    ToolTip.Tip="Abandonner : rien n'est enregistré" />
        </StackPanel>
    </Border>
</Window>
