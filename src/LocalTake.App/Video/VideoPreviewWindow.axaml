<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LocalTake.App.Video.VideoPreviewWindow"
        Title="LocalTake" Width="900" Height="620" MinWidth="560" MinHeight="380" Background="#141414"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#202020" Padding="10,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="RevealButton" Classes="action" Content="📂  Afficher dans le dossier"
                            ToolTip.Tip="Ouvrir le dossier avec la vidéo sélectionnée" />
                    <Button x:Name="RetakeButton" Classes="action" Content="⟲  Refaire"
                            ToolTip.Tip="Envoyer cette vidéo à la Corbeille et en enregistrer une nouvelle de la même façon" />
                    <Button x:Name="DeleteButton" Classes="action" Content="🗑  Supprimer" ToolTip.Tip="Envoyer la vidéo à la Corbeille" />
                </StackPanel>
                <TextBlock x:Name="FileNameText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#DDD" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#202020" Padding="10,6">
            <DockPanel>
                <Button x:Name="PlayButton" DockPanel.Dock="Left" Classes="primary" Content="▶  Lire"
                        ToolTip.Tip="Lire avec le lecteur vidéo du système (Espace)" />
                <TextBlock x:Name="TotalText" DockPanel.Dock="Right" Text="00:00:00" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock x:Name="PositionText" DockPanel.Dock="Left" Text="00:00:00" VerticalAlignment="Center" Margin="10,0,8,0" />
                <Slider x:Name="SeekBar" Minimum="0" Maximum="1" VerticalAlignment="Center"
                        ToolTip.Tip="Parcourir la vidéo (← / → : 10 secondes)" />
            </DockPanel>
        </Border>

        <Grid>
            <Image x:Name="Frame" Stretch="Uniform" Margin="8" />
            <TextBlock x:Name="ErrorText" IsVisible="False" Foreground="#FF8A80" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" TextAlignment="Center" />
            <Popup x:Name="ThumbnailPopup" PlacementTarget="{Binding #SeekBar}" Placement="Top" IsLightDismissEnabled="False">
                <Border Background="#202020" BorderBrush="#555" BorderThickness="1" Padding="3" CornerRadius="3">
                    <StackPanel>
                        <Image x:Name="Thumbnail" Width="200" />
                        <TextBlock x:Name="ThumbnailTime" HorizontalAlignment="Center" Foreground="#DDD" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </DockPanel>
</Window>
