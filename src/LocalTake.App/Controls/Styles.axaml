<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Editor toolbar: tool buttons stay compact and show which tool is active. -->
    <Style Selector="ToggleButton.tool">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#3A6EA5" />
    </Style>

    <Style Selector="Button.action">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="2,0" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Background" Value="#1E88E5" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="#9A9A9A" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.section">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
</Styles>
