<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LocalTake.App.Settings"
        x:Class="LocalTake.App.Settings.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="LocalTake — Réglages" Width="640" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="16,10" Background="#252525">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="Annuler" Command="{Binding CancelCommand}" />
                    <Button Content="Enregistrer" Classes="accent" Command="{Binding SaveCommand}" IsDefault="True" />
                </StackPanel>
                <TextBlock Text="{Binding Error}" Foreground="#FF8A80" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <ScrollViewer MaxHeight="760">
            <StackPanel Margin="16,4,16,12">
                <TextBlock Classes="section" Text="Enregistrement" />
                <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                    <TextBlock Text="Dossier" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding OutputFolder}" />
                    <Button Grid.Column="2" x:Name="BrowseFolderButton" Content="Parcourir…" />

                    <TextBlock Grid.Row="1" Text="Nom des fichiers" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding FileNamePattern}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="hint" Text="{Binding PatternPreview}" />

                    <TextBlock Grid.Row="3" Text="Format" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
                        <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Formats}" SelectedItem="{Binding SelectedFormat}" MinWidth="100" />
                        <TextBlock Text="Qualité JPEG" VerticalAlignment="Center" IsEnabled="{Binding IsJpeg}" />
                        <Slider Minimum="50" Maximum="100" Width="160" Value="{Binding JpegQuality}" IsEnabled="{Binding IsJpeg}"
                                TickFrequency="1" IsSnapToTickEnabled="True" />
                        <TextBlock Text="{Binding JpegQuality}" VerticalAlignment="Center" />
                    </StackPanel>

                    <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" IsChecked="{Binding CopyPathAfterSave}"
                              Content="Copier le chemin du fichier dans le presse-papier après l'enregistrement" />
                </Grid>

                <TextBlock Classes="section" Text="Après une capture" />
                <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.AfterCaptureChoices}" SelectedItem="{Binding SelectedAfterCapture}" MinWidth="320" />

                <TextBlock Classes="section" Text="Vidéo" />
                <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                    <TextBlock Text="ffmpeg" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding FfmpegPath}"
                             ToolTip.Tip="Laisser vide pour le chercher à côté de LocalTake puis dans le PATH." />
                    <Button Grid.Column="2" x:Name="BrowseFfmpegButton" Content="Parcourir…" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="hint" Text="{Binding FfmpegStatus}"
                               Foreground="{Binding FfmpegMissing, Converter={x:Static vm:SettingsConverters.StatusBrush}}" />

                    <TextBlock Grid.Row="2" Text="Micro" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}"
                              HorizontalAlignment="Stretch" />

                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Spacing="2">
                        <CheckBox IsChecked="{Binding RecordMicrophone}" Content="Enregistrer le micro" />
                        <CheckBox IsChecked="{Binding RecordSystemAudio}" IsEnabled="{Binding SystemAudioAvailable}"
                                  ToolTip.Tip="{Binding SystemAudioTip}" Content="Enregistrer le son de l'ordinateur" />
                        <TextBlock Classes="hint"
                                   Text="Les deux se changent aussi sur la barre d'enregistrement, avant de démarrer : le dernier choix est retenu." />
                    </StackPanel>

                    <TextBlock Grid.Row="4" Text="Images/seconde" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.FrameRates}"
                              SelectedItem="{Binding VideoFrameRate}" MinWidth="100" />
                </Grid>

                <TextBlock Classes="section" Text="Raccourcis clavier" />
                <Grid x:Name="HotkeyGrid" ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="4" ColumnSpacing="8">
                    <TextBlock Text="Capturer une zone" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Classes="hotkey" Text="{Binding HotkeyRegion}" />
                    <TextBlock Grid.Row="1" Text="Capturer une fenêtre" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Classes="hotkey" Text="{Binding HotkeyWindow}" />
                    <TextBlock Grid.Row="2" Text="Capturer tout l'écran" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Classes="hotkey" Text="{Binding HotkeyFullScreen}" />
                    <TextBlock Grid.Row="3" Text="Capturer la dernière zone" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Classes="hotkey" Text="{Binding HotkeyLastRegion}" />
                    <TextBlock Grid.Row="4" Text="Vidéo d'une zone" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Classes="hotkey" Text="{Binding HotkeyVideoRegion}" />
                    <TextBlock Grid.Row="5" Text="Vidéo de tout l'écran" VerticalAlignment="Center" />
                    <TextBox Grid.Row="5" Grid.Column="1" Classes="hotkey" Text="{Binding HotkeyVideoFullScreen}" />
                    <TextBlock Grid.Row="6" Text="Démarrer l'enregistrement" VerticalAlignment="Center" />
                    <TextBox Grid.Row="6" Grid.Column="1" Classes="hotkey" Text="{Binding HotkeyVideoStart}" />
                    <TextBlock Grid.Row="7" Text="Arrêter l'enregistrement" VerticalAlignment="Center" />
                    <TextBox Grid.Row="7" Grid.Column="1" Classes="hotkey" Text="{Binding HotkeyVideoStop}" />
                    <Button Grid.Row="8" Grid.Column="1" Content="{Binding DefaultHotkeysLabel}" Command="{Binding DefaultHotkeysCommand}"
                            Margin="0,4,0,0" />
                </Grid>
                <TextBlock Classes="hint" Margin="0,6,0,0"
                           Text="Cliquez dans un champ puis appuyez sur la combinaison. Retour arrière : aucun raccourci. Démarrer et Arrêter ne sont actifs que pendant une vidéo." />

                <CheckBox Margin="0,14,0,0" IsChecked="{Binding StartWithSystem}" Content="{Binding StartupLabel}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
