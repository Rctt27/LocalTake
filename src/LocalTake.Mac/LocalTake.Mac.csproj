<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The macOS app: AppKit and AVKit views and adapters over the core, through .NET's Apple bindings.
    Builds on a Mac only (workload "macos" and the Xcode it requires); LocalTake.Mac.slnx holds it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-macos</TargetFramework>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <!-- One universal app for Apple silicon and Intel Macs. -->
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LocalTake</AssemblyName>
    <RootNamespace>LocalTake.Mac</RootNamespace>
    <ApplicationId>io.github.rctt27.localtake</ApplicationId>
    <ApplicationTitle>LocalTake</ApplicationTitle>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>$(Version)</ApplicationVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalTake.Core\LocalTake.Core.csproj" />
    <ProjectReference Include="..\LocalTake.Infrastructure\LocalTake.Infrastructure.csproj" />
    <ProjectReference Include="..\LocalTake.Platform.MacOS\LocalTake.Platform.MacOS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
