<Window x:Class="ShowTime.RecordingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShowTime — enregistrement" WindowStyle="None" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Background="#2B2B2B"
        BorderBrush="#111" BorderThickness="1" FontSize="13">
    <Window.Resources>
        <Style x:Key="AudioToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Margin" Value="2,0"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Foreground" Value="#888"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- The status and elapsed time, the bar's on/off button: Start when ready, Stop while recording. -->
        <Style x:Key="StatusButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="Background" Value="#3C3C3C"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Orientation="Horizontal" Margin="8,5" ToolTip="Glisser pour déplacer · invisible dans la vidéo">
        <Button x:Name="StatusButton" Style="{StaticResource StatusButton}" IsEnabled="False" Click="Status_Click">
            <StackPanel Orientation="Horizontal">
                <Grid Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse x:Name="Dot" Fill="#E53935" Opacity="0.35" Visibility="Collapsed"/>
                    <Polygon x:Name="PlayIcon" Points="1,0 12,6 1,12" Fill="#E53935" Visibility="Collapsed"/>
                    <Rectangle x:Name="StopSquare" Fill="#E53935" RadiusX="2" RadiusY="2" Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="StatusText" Foreground="#EEE" VerticalAlignment="Center" MinWidth="110"
                           FontFamily="Segoe UI Semibold" Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="StatusHint" Foreground="#AAA" VerticalAlignment="Center" Margin="4,0,2,0" Visibility="Collapsed"/>
            </StackPanel>
        </Button>
        <TextBlock x:Name="HighlightHint" Foreground="#AAA" VerticalAlignment="Center" Margin="2,0,8,0" Visibility="Collapsed"
                   ToolTip="Une traînée jaune suit la souris tant que le déclencheur est maintenu ; elle apparaît dans la vidéo"/>

        <ToggleButton x:Name="MicrophoneToggle" Style="{StaticResource AudioToggle}" Checked="Microphone_Changed" Unchecked="Microphone_Changed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE720;"/>
                <TextBlock x:Name="MicrophoneLabel" Text="Micro" VerticalAlignment="Center"/>
            </StackPanel>
        </ToggleButton>
        <ComboBox x:Name="MicrophoneBox" Visibility="Collapsed" MaxWidth="200" Margin="0,0,4,0" VerticalAlignment="Center"
                  SelectionChanged="MicrophoneBox_SelectionChanged" ToolTip="Micro utilisé"/>
        <ToggleButton x:Name="SystemAudioToggle" Style="{StaticResource AudioToggle}" Checked="SystemAudio_Changed" Unchecked="SystemAudio_Changed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE767;"/>
                <TextBlock x:Name="SystemAudioLabel" Text="Son du PC" VerticalAlignment="Center"/>
            </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="TranscriptionToggle" Style="{StaticResource AudioToggle}" Checked="Transcription_Changed" Unchecked="Transcription_Changed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F0;"/>
                <TextBlock x:Name="TranscriptionLabel" Text="Sous-titres" VerticalAlignment="Center"/>
            </StackPanel>
        </ToggleButton>

        <Button x:Name="CancelButton" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="Cancel_Click"
                ToolTip="Abandonner : rien n'est enregistré">Annuler</Button>
    </StackPanel>
</Window>
