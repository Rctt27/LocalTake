<Window x:Class="ShowTime.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShowTime" Background="#1E1E1E" MinWidth="820" MinHeight="420"
        UseLayoutRounding="True">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2B2B2B" Padding="6,4" BorderBrush="#111" BorderThickness="0,0,0,1">
            <WrapPanel x:Name="Toolbar" VerticalAlignment="Center">
                <RadioButton GroupName="Tools" Style="{StaticResource ToolButton}" Tag="Select" ToolTip="Sélection : déplacer, Suppr pour effacer (V)">↖</RadioButton>
                <RadioButton GroupName="Tools" Style="{StaticResource ToolButton}" Tag="Arrow" ToolTip="Flèche (A)" IsChecked="True">➚</RadioButton>
                <RadioButton GroupName="Tools" Style="{StaticResource ToolButton}" Tag="Line" ToolTip="Ligne (L)">╱</RadioButton>
                <RadioButton GroupName="Tools" Style="{StaticResource ToolButton}" Tag="Rectangle" ToolTip="Rectangle (R)">▭</RadioButton>
                <RadioButton GroupName="Tools" Style="{StaticResource ToolButton}" Tag="Ellipse" ToolTip="Ellipse (E)">◯</RadioButton>
                <RadioButton GroupName="Tools" Style="{StaticResource ToolButton}" Tag="Pen" ToolTip="Crayon (P)">✎</RadioButton>
                <RadioButton GroupName="Tools" Style="{StaticResource ToolButton}" Tag="Highlighter" ToolTip="Surligneur (H)">▌</RadioButton>
                <RadioButton GroupName="Tools" Style="{StaticResource ToolButton}" Tag="Text" ToolTip="Texte (T)" FontWeight="Bold">T</RadioButton>
                <RadioButton GroupName="Tools" Style="{StaticResource ToolButton}" Tag="Number" ToolTip="Numérotation (N)">①</RadioButton>
                <RadioButton GroupName="Tools" Style="{StaticResource ToolButton}" Tag="Blur" ToolTip="Flouter / pixeliser (B)">▦</RadioButton>
                <RadioButton GroupName="Tools" Style="{StaticResource ToolButton}" Tag="Crop" ToolTip="Recadrer (C)">⛶</RadioButton>

                <Rectangle Width="1" Height="22" Fill="#555" Margin="8,0"/>
                <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center"/>

                <Rectangle Width="1" Height="22" Fill="#555" Margin="8,0"/>
                <TextBlock Text="Épaisseur" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="ThicknessBox" Width="52" VerticalAlignment="Center"/>
                <TextBlock Text="Texte" Foreground="#AAA" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <ComboBox x:Name="FontSizeBox" Width="52" VerticalAlignment="Center"/>

                <Rectangle Width="1" Height="22" Fill="#555" Margin="8,0"/>
                <Button x:Name="UndoButton" Style="{StaticResource ActionButton}" ToolTip="Annuler (Ctrl+Z)" Click="Undo_Click">↶</Button>
                <Button x:Name="RedoButton" Style="{StaticResource ActionButton}" ToolTip="Rétablir (Ctrl+Y)" Click="Redo_Click">↷</Button>

                <Rectangle Width="1" Height="22" Fill="#555" Margin="8,0"/>
                <Button Style="{StaticResource ActionButton}" ToolTip="Copier l'image (Ctrl+C)" Click="Copy_Click">Copier</Button>
                <Button Style="{StaticResource ActionButton}" ToolTip="Enregistrer sous… (Ctrl+Maj+S)" Click="SaveAs_Click">Enregistrer sous…</Button>
                <Button Style="{StaticResource PrimaryButton}" ToolTip="Enregistrer dans le dossier des captures (Ctrl+S)" Click="Save_Click">Enregistrer</Button>
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#2B2B2B" Padding="10,4" BorderBrush="#111" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="SizeText" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource ActionButton}" Padding="6,1" ToolTip="Zoom arrière (Ctrl+molette)" Click="ZoomOut_Click">−</Button>
                    <TextBlock x:Name="ZoomText" Foreground="#AAA" VerticalAlignment="Center" Width="44" TextAlignment="Center"/>
                    <Button Style="{StaticResource ActionButton}" Padding="6,1" ToolTip="Zoom avant (Ctrl+molette)" Click="ZoomIn_Click">+</Button>
                    <Button Style="{StaticResource ActionButton}" Padding="6,1" ToolTip="Taille réelle (Ctrl+1)" Click="ZoomActual_Click">1:1</Button>
                    <Button Style="{StaticResource ActionButton}" Padding="6,1" ToolTip="Ajuster à la fenêtre (Ctrl+0)" Click="ZoomFit_Click">Ajuster</Button>
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="#CCC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="#1E1E1E" Focusable="False">
            <Grid x:Name="ZoomHost" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="Zoom"/>
                </Grid.LayoutTransform>
                <Canvas x:Name="Surface" ClipToBounds="True" Background="White" Cursor="Cross">
                    <Image x:Name="BaseImage" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Canvas>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
