<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF and WinForms share many type names; usings stay explicit. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010 targets WinForms-only apps; a WPF app declares its DPI awareness in the manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>LocalTake</AssemblyName>
    <RootNamespace>LocalTake</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
