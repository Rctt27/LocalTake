<Window x:Class="LocalTake.RecordingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalTake — enregistrement" WindowStyle="None" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Background="#2B2B2B"
        BorderBrush="#111" BorderThickness="1" FontSize="13">
    <StackPanel Orientation="Horizontal" Margin="8,5" ToolTip="Glisser pour déplacer · invisible dans la vidéo">
        <Ellipse x:Name="Dot" Width="12" Height="12" Fill="#E53935" VerticalAlignment="Center" Margin="2,0,8,0"/>
        <TextBlock x:Name="StatusText" Foreground="#EEE" VerticalAlignment="Center" MinWidth="110"
                   FontFamily="Segoe UI Semibold"/>
        <Button x:Name="StopButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Stop_Click"
                ToolTip="Arrêter et enregistrer (même raccourci que pour démarrer)">■  Arrêter</Button>
        <Button x:Name="CancelButton" Style="{StaticResource ActionButton}" Margin="4,0,0,0" Click="Cancel_Click"
                ToolTip="Abandonner l'enregistrement">Annuler</Button>
    </StackPanel>
</Window>
