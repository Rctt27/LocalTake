<Window x:Class="LocalTake.RecordingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalTake — enregistrement" WindowStyle="None" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Background="#2B2B2B"
        BorderBrush="#111" BorderThickness="1" FontSize="13">
    <Window.Resources>
        <Style x:Key="AudioToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Margin" Value="2,0"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Foreground" Value="#888"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Orientation="Horizontal" Margin="8,5" ToolTip="Glisser pour déplacer · invisible dans la vidéo">
        <Ellipse x:Name="Dot" Width="12" Height="12" Fill="#E53935" VerticalAlignment="Center" Margin="2,0,8,0"/>
        <TextBlock x:Name="StatusText" Foreground="#EEE" VerticalAlignment="Center" MinWidth="110"
                   FontFamily="Segoe UI Semibold" Typography.NumeralAlignment="Tabular"/>

        <ToggleButton x:Name="MicrophoneToggle" Style="{StaticResource AudioToggle}" Checked="Microphone_Changed" Unchecked="Microphone_Changed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE720;"/>
                <TextBlock x:Name="MicrophoneLabel" Text="Micro" VerticalAlignment="Center"/>
            </StackPanel>
        </ToggleButton>
        <ComboBox x:Name="MicrophoneBox" Visibility="Collapsed" MaxWidth="200" Margin="0,0,4,0" VerticalAlignment="Center"
                  SelectionChanged="MicrophoneBox_SelectionChanged" ToolTip="Micro utilisé"/>
        <ToggleButton x:Name="SystemAudioToggle" Style="{StaticResource AudioToggle}" Checked="SystemAudio_Changed" Unchecked="SystemAudio_Changed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE767;"/>
                <TextBlock x:Name="SystemAudioLabel" Text="Son du PC" VerticalAlignment="Center"/>
            </StackPanel>
        </ToggleButton>

        <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Start_Click"
                ToolTip="Lancer le compte à rebours de 3 secondes, puis l'enregistrement">●  Démarrer</Button>
        <Button x:Name="StopButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Stop_Click"
                Visibility="Collapsed" ToolTip="Arrêter et enregistrer la vidéo">■  Arrêter</Button>
        <Button x:Name="CancelButton" Style="{StaticResource ActionButton}" Margin="4,0,0,0" Click="Cancel_Click"
                ToolTip="Abandonner : rien n'est enregistré">Annuler</Button>
    </StackPanel>
</Window>
