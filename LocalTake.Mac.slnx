    <Project Path="src/LocalTake.Core/LocalTake.Core.csproj" />
    <Project Path="src/LocalTake.Infrastructure/LocalTake.Infrastructure.csproj" />
    <Project Path="src/LocalTake.Platform.MacOS/LocalTake.Platform.MacOS.csproj" />
    <Project Path="src/LocalTake.Mac/LocalTake.Mac.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/LocalTake.Core.Tests/LocalTake.Core.Tests.csproj" />
    <Project Path="tests/LocalTake.Infrastructure.IntegrationTests/LocalTake.Infrastructure.IntegrationTests.csproj" />
    <Project Path="tests/LocalTake.Platform.Tests/LocalTake.Platform.Tests.csproj" />
  </Folder>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="global.json" />
  </Folder>
</Solution>
